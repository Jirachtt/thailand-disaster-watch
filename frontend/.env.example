# Local database used by the reports API
DATABASE_URL="file:./prisma/dev.db"

# Required for live NASA FIRMS hotspot data
# Request a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=replace_with_your_firms_map_key

# Optional: Open-Meteo is used automatically when this is empty
OPENWEATHER_API_KEY=

# Legacy optional setting; the dashboard currently uses Open-Meteo CAMS for AQI
AQICN_API_TOKEN=
