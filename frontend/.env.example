# Local database used by the reports API
DATABASE_URL="file:./prisma/dev.db"

# Required for live NASA FIRMS hotspot data
# Request a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=replace_with_your_firms_map_key

# Optional: used by weather inputs in fire/rain calculations
OPENWEATHER_API_KEY=

# Required for current AQI measurements from real monitoring stations.
# Create a token at https://aqicn.org/data-platform/token/
# Keep this server-side and mark it Sensitive in Vercel.
AQICN_API_TOKEN=replace_with_your_aqicn_token
